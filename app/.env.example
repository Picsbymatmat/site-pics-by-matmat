# Copy to .env.local and fill in. Never commit real values.

# n8n webhook the call sheet POSTs bookings to (§2)
VITE_BOOKING_WEBHOOK_URL=

# Cloudinary cloud name only — safe to expose client-side, used for
# unsigned delivery URL construction (§11)
VITE_CLOUDINARY_CLOUD_NAME=

# Build-time only, used by scripts/generate-cloudinary-manifest.mjs.
# Never prefix with VITE_ — that would bundle it into client code.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
