# Copy to .env.local and fill in. Never commit real values.

# Cloudinary cloud name only — safe to expose client-side, used for
# unsigned delivery URL construction and the public tag-list endpoint
# (§11, §12). No API key/secret needed anywhere: "Resource list" must be
# enabled in Cloudinary's security settings for the account instead.
VITE_CLOUDINARY_CLOUD_NAME=

# ---- Server-side only below this line. Never VITE_-prefixed, never sent
# to the browser — set these in Netlify's own environment variable UI, not
# in a committed .env file. Shared by netlify/functions/slots.ts (reads
# availability) and booking.ts (creates the actual booking). ----

# Cal.com v2 API key. slots.ts uses it to read real availability for the
# inline date/slot picker (§8, §9); booking.ts uses the same key to create
# a pending booking against the exact slot picked there. A booking is
# "pending" because the Cal.com event type has "requires confirmation"
# turned on in Matt's dashboard — this key does not itself request pending
# status.
CALCOM_API_KEY=

# Numeric Cal.com event-type ID per shoot category, since pricing/duration
# differ enough across the four to want separate event types (§9). Find
# these in Cal.com's dashboard (event type's own settings page shows its
# numeric ID, or list them via the v2 API's event-types endpoint).
CALCOM_EVENT_TYPE_ID_PRODUCT=
CALCOM_EVENT_TYPE_ID_BRAND=
CALCOM_EVENT_TYPE_ID_EVENT=
CALCOM_EVENT_TYPE_ID_PORTRAIT=
